# EssayFlow — environment variables
# Copy to .env.local. Never commit real secrets.

# Public base URL (used for metadataBase / Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing key (HMAC-SHA256). REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google authentication (optional). Without these the provider reports itself unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Reserved for later modules ---
# AI_PROVIDER_API_KEY=
# DATABASE_URL=
